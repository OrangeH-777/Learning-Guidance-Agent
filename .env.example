# Copy to .env in the repository root. Never commit real credentials.
# Liveness starts without a database; business endpoints need migrations and PostgreSQL.
# Example syntax (replace every placeholder and URL-encode special password characters):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/learning_guidance
DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Active authentication and encrypted PERSONAL model settings.
# Fernet key: generated by setup_local_database; never use a human-chosen password here.
MODEL_CREDENTIAL_ENCRYPTION_KEY=
MODEL_CREDENTIAL_PREVIOUS_KEYS=[]
SESSION_TTL_SECONDS=7200
COOKIE_SECURE=false
# Set locally, then run: uv run --locked python -m scripts.bootstrap_admin
# Initial creation only; rerunning never promotes a normal user or resets a password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173","http://127.0.0.1:8000"]
# Exact origins only, e.g. ["http://127.0.0.1:11434"]. Default requires public HTTPS.
MODEL_ENDPOINT_ALLOWLIST=[]

# Deployment-owned embedding configuration, independent from each user's chat model.
# Set EMBEDDING_PROTOCOL=openai_compatible after selecting your embedding service.
EMBEDDING_PROTOCOL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_INDEX_VERSION=

# Active workflow limits.
MODEL_CALL_TIMEOUT_SECONDS=60
TASK_TIMEOUT_SECONDS=180
CONTENT_REGENERATION_LIMIT=2
MODEL_TRANSPORT_RETRY_LIMIT=1
GLOBAL_GENERATION_LIMIT=2
USER_ACTIVE_TASK_LIMIT=1
# Blank means no additional waiting slots (at most two accepted active tasks).
# Any larger queue must be evaluated against the 180-second acceptance deadline.
TASK_QUEUE_CAPACITY=
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_COSINE_DISTANCE=0.8
KNOWLEDGE_CHUNK_CHARACTERS=1200
# Retrieval values are development starting points, not measured quality guarantees.

# Private uploads are runtime data, never placed in knowledge/ or frontend/public/.
PUBLIC_KNOWLEDGE_DIR=knowledge
# Reserved for S12, not read by the current application.
PRIVATE_UPLOAD_DIR=var/uploads
